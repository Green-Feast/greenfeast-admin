NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron/renewal-reminders — set to a random value (e.g. `openssl
# rand -hex 32`) in Vercel's project env vars. Vercel automatically sends it
# as `Authorization: Bearer $CRON_SECRET` when the cron fires.
CRON_SECRET=

# WhatsApp sending is not wired up yet (see lib/notifications.ts) — these are
# placeholders for whichever provider gets picked later (Meta Cloud API,
# Gupshup, Interakt, AiSensy, ...). Leaving them unset keeps the WhatsApp
# channel a clean no-op everywhere it's offered.
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Protects /api/cron/renewal-reminders and /api/cron/instantiate-orders — set
# to a random value (e.g. `openssl rand -hex 32`) in Vercel's project env
# vars. Vercel automatically sends it as `Authorization: Bearer $CRON_SECRET`
# when a cron fires.
CRON_SECRET=

# Shared secret for calling Supabase Edge Functions that require
# service-role-equivalent access from OUTSIDE Supabase's own edge runtime
# (this admin app's cron routes, kitchen/actions.ts, users/actions.ts).
# NOT the same as SUPABASE_SECRET_KEY above — that's this app's own secret
# key, used for normal table access via supabase-admin.ts, but
# `Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')` *inside* an Edge Function on
# this project resolves to a different value, so it can't be used as a
# bearer token from here. Must match the
# INTERNAL_FN_SECRET set via `supabase secrets set` on the Supabase project;
# instantiate-orders checks against it explicitly (see its source).
INTERNAL_FN_SECRET=

# WhatsApp sending is not wired up yet (see lib/notifications.ts) — these are
# placeholders for whichever provider gets picked later (Meta Cloud API,
# Gupshup, Interakt, AiSensy, ...). Leaving them unset keeps the WhatsApp
# channel a clean no-op everywhere it's offered.
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
